# Doxygen config for the skill eval harness. Run from the repo root: doxygen Doxyfile
PROJECT_NAME           = "Skill eval harness"
OUTPUT_DIRECTORY       = doxygen
INPUT                  = test_harness
RECURSIVE              = YES
FILE_PATTERNS          = *.py
EXCLUDE_PATTERNS       = */tests/* */results/* */__pycache__/*
# Doxygen's Python support uses the Java output rules, not the C ones.
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
